# ──────────────────────────────────────────────────────────────────────────────
# SkyRecon – .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# ── Node / Frontend ────────────────────────────────────────────────────────────
node_modules/
dist/
dist-ssr/
*.local
.cache/
.parcel-cache/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Python / Backend ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyd
*.pyo
*.egg
*.egg-info/
dist/
build/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Virtual environments
venv/
.venv/
env/
ENV/
.env.bak

# ── Secrets — CRITICAL — Never commit ─────────────────────────────────────────
.env
*.env
!.env.example
!backend/.env.example

# ── Database files ─────────────────────────────────────────────────────────────
*.db
*.sqlite3
*.sqlite

# ── AI Model Weights (large binary — use Git LFS or cloud storage) ─────────────
*.pt
*.pth
*.onnx
*.engine
*.trt
*.weights
!backend/yolov8n.pt    # Remove these lines if you DO want to track them via LFS

# ── Uploads / Generated Media ──────────────────────────────────────────────────
backend/uploads/
backend/screenshots/
backend/reports/
backend/runs/
media/

# ── HuggingFace Cache (auto-downloaded models) ────────────────────────────────
.cache/huggingface/
huggingface/

# ── Editor / IDE ───────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ── OS Files ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── Jupyter Notebooks (outputs only — keep .ipynb files) ──────────────────────
.ipynb_checkpoints/

# ── Deployment ─────────────────────────────────────────────────────────────────
.vercel/
.netlify/
.render/
render.yaml.local
railway.local.json