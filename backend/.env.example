# SkyRecon Backend – Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# LOCAL:  Copy this file → .env and fill in your values
# RENDER: Set each variable in Dashboard → Environment → Add Environment Variable
# RAILWAY: Set via railway.toml or Dashboard → Variables
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=SkyRecon
APP_VERSION=1.0.0
DEBUG=false

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# Local:   use localhost + your credentials below
# Neon:    use the connection string from neon.tech dashboard
# Railway: auto-injected as DATABASE_URL — see DEPLOYMENT.md
DB_HOST=localhost
DB_PORT=5432
DB_NAME=skyrecon
DB_USER=postgres
DB_PASSWORD=your_password_here

# ── Full connection URL (overrides above if set — used by Neon/Railway) ───────
# DATABASE_URL=postgresql://user:password@host:5432/skyrecon

# ── AI Engine ─────────────────────────────────────────────────────────────────
# yolov8n.pt = fastest, least accurate (nano)    ← use on free-tier servers
# yolov8s.pt = good balance of speed + accuracy  ← recommended default
# yolov8x.pt = most accurate, slowest            ← use only with GPU
YOLO_MODEL=yolov8s.pt
CONFIDENCE_THRESHOLD=0.35

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Local:    http://localhost:3000
# Deployed: https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
SCREENSHOT_DIR=screenshots
REPORTS_DIR=reports
MAX_UPLOAD_SIZE_MB=500
